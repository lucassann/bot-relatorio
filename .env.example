# Token do seu Bot no Telegram (obtenha com o @BotFather no Telegram)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Chave de API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
GEMINI_API_KEY=sua_api_key_aqui

# Modelo do Gemini a ser utilizado (padrão: gemini-2.5-flash ou gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
